----------------------------------------------------------------------
-- Dynamic Viewport Screen Clamping & Smooth Dragging
-- (Prevents GUI elements from being dragged off-screen on ANY monitor size)
----------------------------------------------------------------------
-- Clamp MainFrame (880x530) within screen boundaries (Pure pixel coordinates)
local function clampMainFrameOffset(offset)
    local vp = getViewportSize()
    local maxX = math.max(0, vp.X - 880)
    local maxY = math.max(0, vp.Y - 530)

    return Vector2.new(
        math.clamp(offset.X, 0, maxX),
        math.clamp(offset.Y, 0, maxY)
    )
end

-- Clamp Watermark within screen boundaries
local function clampWatermarkOffset(offset)
    local vp = getViewportSize()
    local wmWidth = WatermarkFrame.AbsoluteSize.X
    if wmWidth < 50 then wmWidth = 280 end
    local wmHeight = WatermarkFrame.AbsoluteSize.Y
    if wmHeight < 20 then wmHeight = 32 end

    if vp.X < wmWidth + 50 or vp.Y < wmHeight + 50 then
        return offset
    end

    return Vector2.new(
        math.clamp(offset.X, 0, vp.X - wmWidth),
        math.clamp(offset.Y, 0, vp.Y - wmHeight)
    )
end

-- Clamp Keybinds within screen boundaries
local function clampKeybindsOffset(offset)
    local vp = getViewportSize()
    local kbHeight = KeybindsFrame.AbsoluteSize.Y
    if kbHeight < 20 then kbHeight = 26 end

    if vp.X < 200 or vp.Y < kbHeight + 50 then
        return offset
    end

    return Vector2.new(
        math.clamp(offset.X, 0, vp.X - 150),
        math.clamp(offset.Y, 0, vp.Y - kbHeight)
    )
end

