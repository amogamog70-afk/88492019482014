    if show == nil then
        show = not menuOpen
    end
    menuOpen = show

    if activeScaleTween then activeScaleTween:Cancel() end

    if menuOpen then
        MainFrame.Visible = true
        MainScale.Scale = 0.96
        activeScaleTween = TweenService:Create(MainScale, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1.0})
        activeScaleTween:Play()
    else
        isDragging = false
        activeScaleTween = TweenService:Create(MainScale, TweenInfo.new(0.14, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Scale = 0.96})
        activeScaleTween:Play()

        task.delay(0.14, function()
            if not menuOpen then
                MainFrame.Visible = false
            end
        end)
    end
end

