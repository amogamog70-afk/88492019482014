            if s then
                local contentHeight = s.AbsoluteCanvasSize.Y > 0 and s.AbsoluteCanvasSize.Y or s.CanvasSize.Y.Offset
                local maxScroll = math.max(0, contentHeight - s.AbsoluteSize.Y)
                if maxScroll > 0 then
                    local newY = math.clamp(s.CanvasPosition.Y - (scrollDelta * scrollSpeed), 0, maxScroll)
                    s.CanvasPosition = Vector2.new(0, newY)
                end
            end
        end
    end
end)

