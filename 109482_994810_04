            -- 9. Add Graph (Interactive Curve / Graph Editor)
            function Column:AddGraph(graphName, graphConfig, callback)
                graphName = graphName or "Curve Graph"
                graphConfig = graphConfig or {}
                callback = callback or function() end

                local minY = graphConfig.MinY or 0
                local maxY = graphConfig.MaxY or 100
                local defaultPoints = graphConfig.Points or { {0, 20}, {0.33, 45}, {0.66, 75}, {1.0, 95} }

                local points = {}
                for i, p in ipairs(defaultPoints) do
                    points[i] = {
                        math.clamp(p[1], 0, 1),
                        math.clamp(p[2], minY, maxY)
                    }
                end

                local Row = Instance.new("Frame")
                Row.Name = "GraphRow_" .. graphName
                Row.Active = false
                Row.Size = UDim2.new(1, 0, 0, 136)
                Row.BackgroundTransparency = 1
                Row.ZIndex = 24
