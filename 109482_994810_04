-- Universal Icon Resolver: accepts number IDs, string IDs, rbxassetid URLs, or preset names
local function resolveIcon(iconInput, fallbackName)
    if iconInput == false then return nil end

    if not iconInput and fallbackName then
        local rawStr = string.lower(tostring(fallbackName))
        local key = rawStr:gsub("%s+", "")
        local found = defaultTabIcons[rawStr] or defaultTabIcons[key]
        if found then
            return "rbxassetid://" .. tostring(found):gsub("%D", "")
        end
        return nil
    end

    if not iconInput then return nil end

    if type(iconInput) == "number" then
        return "rbxassetid://" .. tostring(math.floor(iconInput))
    end

    local str = tostring(iconInput)
    if str:find("rbxassetid://") or str:find("http://") or str:find("https://") or str:find("rbxasset://") then
        return str
    end

    if str:match("^%d+$") then
        return "rbxassetid://" .. str
    end

    local rawStr = string.lower(str)
    local key = rawStr:gsub("%s+", "")
    local found = defaultTabIcons[rawStr] or defaultTabIcons[key]
    if found then
        return "rbxassetid://" .. tostring(found):gsub("%D", "")
    end

    local digits = str:gsub("%D", "")
    if #digits > 5 then
        return "rbxassetid://" .. digits
    end

    return nil
end

function DeadHub:GetIcon(identifier)
    return resolveIcon(identifier)
end

function DeadHub:CreateWindow(config)
    config = config or {}
    local windowTitle = config.Title or config.Name or '<font color="#e63946">Dead</font>Hub'
    local windowSubtitle = config.Subtitle or config.SubTitle or "TRIDENT SURVIVAL"

    local ThemeFont = pcall(function() return Enum.Font.BuilderSansMedium end) and Enum.Font.BuilderSansMedium or Enum.Font.GothamMedium
    local ThemeFontBold = pcall(function() return Enum.Font.BuilderSansBold end) and Enum.Font.BuilderSansBold or Enum.Font.GothamBold

    -- Clean up any existing DeadHub instances
    if parentContainer then
        for _, child in ipairs(parentContainer:GetChildren()) do
            if child.Name:sub(1, 8) == "DeadHub_" then
                pcall(function() child:Destroy() end)
            end
        end
    end

    -- ScreenGui Setup
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "DeadHub_" .. tostring(math.random(100000, 999999))
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.DisplayOrder = 999
    ScreenGui.Parent = parentContainer

