-- Universal Icon Resolver: accepts number IDs, string IDs, rbxassetid URLs, or preset names
local function resolveIcon(iconInput, fallbackName)
    if iconInput == false then return nil end

    if not iconInput and fallbackName then
        local rawStr = string.lower(tostring(fallbackName))
        local key = rawStr:gsub("%s+", "")
        local found = defaultTabIcons[rawStr] or defaultTabIcons[key]
        if found then
            return "rbxassetid://" .. tostring(found):gsub("%D", "")
        end
        return nil
    end

    if not iconInput then return nil end

    if type(iconInput) == "number" then
        return "rbxassetid://" .. tostring(math.floor(iconInput))
    end

    local str = tostring(iconInput)
    if str:find("rbxassetid://") or str:find("http://") or str:find("https://") or str:find("rbxasset://") then
        return str
    end

    if str:match("^%d+$") then
        return "rbxassetid://" .. str
    end

    local rawStr = string.lower(str)
    local key = rawStr:gsub("%s+", "")
    local found = defaultTabIcons[rawStr] or defaultTabIcons[key]
    if found then
        return "rbxassetid://" .. tostring(found):gsub("%D", "")
    end

    local digits = str:gsub("%D", "")
    if #digits > 5 then
        return "rbxassetid://" .. digits
    end

    return nil
end

-- Color Utilities (File scope to avoid 200 local variables limit)
local function rgbToHex(color)
    local r = math.clamp(math.floor(color.R * 255 + 0.5), 0, 255)
    local g = math.clamp(math.floor(color.G * 255 + 0.5), 0, 255)
    local b = math.clamp(math.floor(color.B * 255 + 0.5), 0, 255)
    return string.format("#%02x%02x%02x", r, g, b)
end

local function hexToRgb(hex)
    if not hex or type(hex) ~= "string" then return nil end
    local clean = hex:gsub("#", ""):gsub("%s+", "")
    if #clean == 3 then
        local r = tonumber(string.rep(clean:sub(1, 1), 2), 16)
        local g = tonumber(string.rep(clean:sub(2, 2), 2), 16)
        local b = tonumber(string.rep(clean:sub(3, 3), 2), 16)
        if r and g and b then return Color3.fromRGB(r, g, b) end
    elseif #clean == 6 then
        local r = tonumber(clean:sub(1, 2), 16)
        local g = tonumber(clean:sub(3, 4), 16)
        local b = tonumber(clean:sub(5, 6), 16)
        if r and g and b then return Color3.fromRGB(r, g, b) end
    end
    return nil
end

