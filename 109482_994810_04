            kbTargetOffset = clampKeybindsOffset(rawOffset)
        elseif isDragging then
            local deltaX = mx - dragStart.X
            local deltaY = my - dragStart.Y
            local rawOffset = startPos + Vector2.new(deltaX, deltaY)
            targetOffset = clampMainFrameOffset(rawOffset)
        end
    elseif input.UserInputType == Enum.UserInputType.MouseWheel then
        -- Smooth Zero-GPE Mouse Wheel scrolling for Column cards
        local scrollDelta = input.Position.Z
        local mx = input.Position.X
        local my = input.Position.Y



        if DropdownOverlay.IsVisible() and isInside(mx, my, DropdownOverlay.Window) then
            DropdownOverlay.HandleWheel(scrollDelta)
            return
        end

        if activeTab and MainFrame.Visible and menuOpen then
            local scrollSpeed = 40
            local s = nil
            if activeTab.leftScroll and isInside(mx, my, activeTab.leftScroll) then
                s = activeTab.leftScroll
            elseif activeTab.rightScroll and isInside(mx, my, activeTab.rightScroll) then
                s = activeTab.rightScroll
