-- Unified single InputBegan handler: processes clicks, context menus, and bound key triggers
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local clickX = input.Position.X
        local clickY = input.Position.Y

        -- 0. Check if Watermark was clicked for dragging (Priority hit-test)
        if WatermarkFrame.Visible and watermarkEnabled and isInside(clickX, clickY, WatermarkFrame) then
            isDraggingWM = true
            wmDragStart = Vector2.new(clickX, clickY)
            wmStartOffset = Vector2.new(WatermarkFrame.Position.X.Offset, WatermarkFrame.Position.Y.Offset)
            wmCurrentOffset = wmStartOffset
            wmTargetOffset = wmStartOffset
            return
        end

        -- 1. Check if Keybinds widget was clicked for dragging (Priority hit-test)
        if KeybindsFrame.Visible and keybindsEnabled and isInside(clickX, clickY, KeybindsFrame) then
            isDraggingKB = true
            kbDragStart = Vector2.new(clickX, clickY)
            kbStartOffset = Vector2.new(KeybindsFrame.Position.X.Offset, KeybindsFrame.Position.Y.Offset)
            kbCurrentOffset = kbStartOffset
            kbTargetOffset = kbStartOffset
            return
        end

        if MainFrame.Visible and menuOpen then
            -- Check Context Menu left clicks
            if ContextMenu.Visible then
                if isInside(clickX, clickY, ContextMenu) then
                    if isInside(clickX, clickY, CtxKeybindRow) then
                        isListeningKeybind = not isListeningKeybind
                        updateContextMenuUI()
                        return
                    end
                    for mName, mObj in pairs(modeButtons) do
                        if isInside(clickX, clickY, mObj.row) then
                            isListeningKeybind = false
                            activeContextItem.setMode(mName)
                            updateContextMenuUI()
                            return
                        end
                    end
                    return
                else
                    ContextMenu.Visible = false
                    isListeningKeybind = false
                    activeContextItem = nil
                end
            end

            -- 2. Check Settings Popup clicks & outside dismissal
            if SettingsPopup and SettingsPopup.Visible then
                if isInside(clickX, clickY, SettingsPopup) then
                    if isInside(clickX, clickY, WatermarkRow) then
                        toggleWatermark()
                        return
                    elseif isInside(clickX, clickY, KeybindsToggleRow) then
                        toggleKeybinds()
                        return
                    elseif isInside(clickX, clickY, KeybindRow) then
                        isListeningMenuKey = not isListeningMenuKey
                        updateMenuKeyUI()
                        return
                    end
                    return -- Click was inside popup body/header, absorb to keep open
                else
                    SettingsPopup.Visible = false
                    if isListeningMenuKey then
                        isListeningMenuKey = false
                        updateMenuKeyUI()
                    end
                    if isInside(clickX, clickY, ThreeDotsBtn) then
                        return -- If clicked 3 dots while open, close it and consume click
                    end
                end
            end

            -- 3. Check if 3 Dots button was clicked (when popup was closed)
            if isInside(clickX, clickY, ThreeDotsBtn) then
                if SettingsPopup then
                    SettingsPopup.Visible = true
                end
                return
            end

            -- 5. Check if Header was clicked for dragging
            if isInside(clickX, clickY, Header) then
                isDragging = true
                dragStart = Vector2.new(clickX, clickY)
                startPos = Vector2.new(MainFrame.Position.X.Offset, MainFrame.Position.Y.Offset)
                currentOffset = startPos
                targetOffset = startPos
                return
            end

            -- 6. Check Active Sliders
            for _, s in ipairs(sliderRegistry) do
                if s.hitbox and isInside(clickX, clickY, s.hitbox) then
                    activeSlider = s
                    s.update(clickX)
                    return
                end
            end

            -- 7. Check Clickable components in active Tab (Toggles, Buttons, Tabs, Textboxes)
            for _, item in ipairs(clickableRegistry) do
                if item.object and isInside(clickX, clickY, item.object) then
                    item.onClick()
                    return
                end
            end
        end
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        local clickX = input.Position.X
        local clickY = input.Position.Y

        if MainFrame.Visible and menuOpen then
            for _, item in ipairs(rightClickRegistry) do
                if item.object and isInside(clickX, clickY, item.object) then
                    activeContextItem = item
                    isListeningKeybind = false
                    updateContextMenuUI()

                    local vp = getViewportSize()
                    local targetX = math.clamp(clickX, 0, vp.X - 145)
                    local targetY = math.clamp(clickY, 0, vp.Y - 140)
                    ContextMenu.Position = UDim2.fromOffset(targetX, targetY)
                    ContextMenu.Visible = true
                    return
                end
            end
        end

        if SettingsPopup and SettingsPopup.Visible then
            SettingsPopup.Visible = false
            if isListeningMenuKey then
                isListeningMenuKey = false
                updateMenuKeyUI()
            end
        end

        if ContextMenu.Visible then
            ContextMenu.Visible = false
            isListeningKeybind = false
            activeContextItem = nil
        end
    elseif not gameProcessed then
        if isListeningMenuKey then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                pcall(function()
                    if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                        menuKey = nil
                    elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                        menuKey = input.KeyCode
                    end
                end)
                isListeningMenuKey = false
                updateMenuKeyUI()
                return
            end
        end

        if isListeningKeybind and activeContextItem then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                pcall(function()
                    if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                        activeContextItem.setKey(nil)
                    elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                        activeContextItem.setKey(input.KeyCode)
                    end
                end)
                isListeningKeybind = false
                updateContextMenuUI()
                return
            end
        end

        if (menuKey and input.KeyCode == menuKey) or input.KeyCode == Enum.KeyCode.Insert then
            toggleMenu()
        else
            -- Check Gameplay Keybind Triggers
            for _, item in ipairs(rightClickRegistry) do
                local k = item.getKey()
                if k and input.KeyCode == k then
                    local m = item.getMode()
                    if m == "toggle" then
                        item.toggle()
                    elseif m == "hold" then
                        item.set(true)
                    end
                end
            end
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        local mousePos = input.Position
        local mx = mousePos.X
        local my = mousePos.Y

        local anyInteractiveHovered = false

        -- Neverlose-style dynamic smooth hover reactions (Zero-GPE)
        if MainFrame.Visible and menuOpen then
            for _, item in ipairs(clickableRegistry) do
                if item.object then
                    local isHov = isInside(mx, my, item.object)
                    if isHov then
                        anyInteractiveHovered = true
                    end
                    if item.onHover then
                        if item._isHovered ~= isHov then
                            item._isHovered = isHov
                            pcall(item.onHover, isHov)
                        end
                    end
                end
            end

            for _, s in ipairs(sliderRegistry) do
                if s.hitbox and isInside(mx, my, s.hitbox) then
                    anyInteractiveHovered = true
                    break
                end
            end
        end

        -- Update Pointing Hand cursor when hovering interactive elements
        if Mouse then
            pcall(function()
                Mouse.Icon = anyInteractiveHovered and "rbxasset://SystemCursors/PointingHand" or ""
            end)
        end

        if activeSlider then
            activeSlider.update(input.Position.X)
        elseif isDraggingWM then
            local deltaX = input.Position.X - wmDragStart.X
            local deltaY = input.Position.Y - wmDragStart.Y
            local rawOffset = wmStartOffset + Vector2.new(deltaX, deltaY)
            wmTargetOffset = clampWatermarkOffset(rawOffset)
        elseif isDraggingKB then
            local deltaX = input.Position.X - kbDragStart.X
            local deltaY = input.Position.Y - kbDragStart.Y
            local rawOffset = kbStartOffset + Vector2.new(deltaX, deltaY)
            kbTargetOffset = clampKeybindsOffset(rawOffset)
        elseif isDragging then
            local deltaX = input.Position.X - dragStart.X
            local deltaY = input.Position.Y - dragStart.Y
            local rawOffset = startPos + Vector2.new(deltaX, deltaY)
            targetOffset = clampMainFrameOffset(rawOffset)
        end
    elseif input.UserInputType == Enum.UserInputType.MouseWheel then
        -- Smooth Zero-GPE Mouse Wheel scrolling for Column cards
        local scrollDelta = input.Position.Z
        local mouse = UserInputService:GetMouseLocation()
        local inset = GuiService:GetGuiInset()
        local mx = mouse.X - inset.X
        local my = mouse.Y - inset.Y

        if activeTab and MainFrame.Visible and menuOpen then
            local scrollSpeed = 40
            if activeTab.leftScroll and isInside(mx, my, activeTab.leftScroll) then
                local s = activeTab.leftScroll
                local maxScroll = math.max(0, s.CanvasSize.Y.Offset - s.AbsoluteSize.Y)
                local newY = math.clamp(s.CanvasPosition.Y - (scrollDelta * scrollSpeed), 0, maxScroll)
                s.CanvasPosition = Vector2.new(0, newY)
            elseif activeTab.rightScroll and isInside(mx, my, activeTab.rightScroll) then
                local s = activeTab.rightScroll
                local maxScroll = math.max(0, s.CanvasSize.Y.Offset - s.AbsoluteSize.Y)
                local newY = math.clamp(s.CanvasPosition.Y - (scrollDelta * scrollSpeed), 0, maxScroll)
                s.CanvasPosition = Vector2.new(0, newY)
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = false
        isDraggingWM = false
        isDraggingKB = false
