local function isInside(x, y, obj)
    if not obj or not obj.Visible then return false end
    -- Check visibility of all ancestors up to ScreenGui (prevents hidden tabs from registering clicks)
    local curr = obj.Parent
    while curr and curr ~= ScreenGui and curr ~= game do
        if curr:IsA("GuiObject") and not curr.Visible then
            return false
        end
        curr = curr.Parent
    end
    local pos = obj.AbsolutePosition
    local size = obj.AbsoluteSize
    return x >= pos.X and x <= (pos.X + size.X)
       and y >= pos.Y and y <= (pos.Y + size.Y)
end

-- Interactive Zero-GPE Component Registries
local clickableRegistry = {}
local sliderRegistry = {}
local activeSlider = nil

-- Unified single InputBegan handler: processes clicks and toggle keybinds
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local clickX = input.Position.X
        local clickY = input.Position.Y

        -- 0. Check if Watermark was clicked for dragging (Priority hit-test)
        if WatermarkFrame.Visible and watermarkEnabled and isInside(clickX, clickY, WatermarkFrame) then
            isDraggingWM = true
            wmDragStart = Vector2.new(clickX, clickY)
            wmStartOffset = Vector2.new(WatermarkFrame.Position.X.Offset, WatermarkFrame.Position.Y.Offset)
            wmCurrentOffset = wmStartOffset
            wmTargetOffset = wmStartOffset
            return
        end

        -- 1. Check if Keybinds widget was clicked for dragging (Priority hit-test)
        if KeybindsFrame.Visible and keybindsEnabled and isInside(clickX, clickY, KeybindsFrame) then
            isDraggingKB = true
            kbDragStart = Vector2.new(clickX, clickY)
            kbStartOffset = Vector2.new(KeybindsFrame.Position.X.Offset, KeybindsFrame.Position.Y.Offset)
            kbCurrentOffset = kbStartOffset
            kbTargetOffset = kbStartOffset
            return
        end

        if MainFrame.Visible and menuOpen then
            -- 2. Check if 3 Dots button was clicked
            if isInside(clickX, clickY, ThreeDotsBtn) then
                SettingsPopup.Visible = not SettingsPopup.Visible
                return
            end

            -- 3. Check if Watermark toggle was clicked (inside SettingsPopup)
            if SettingsPopup.Visible and isInside(clickX, clickY, WatermarkRow) then
                toggleWatermark()
                return
            end

            -- 4. Check if Keybinds toggle was clicked (inside SettingsPopup)
            if SettingsPopup.Visible and isInside(clickX, clickY, KeybindsToggleRow) then
                toggleKeybinds()
                return
            end

            -- 5. Check if Header was clicked for dragging
            if isInside(clickX, clickY, Header) then
                isDragging = true
                dragStart = Vector2.new(clickX, clickY)
                startPos = Vector2.new(MainFrame.Position.X.Offset, MainFrame.Position.Y.Offset)
                currentOffset = startPos
                targetOffset = startPos
                return
            end

            -- 6. Check Active Sliders
            for _, s in ipairs(sliderRegistry) do
                if s.hitbox and isInside(clickX, clickY, s.hitbox) then
                    activeSlider = s
                    s.update(clickX)
                    return
                end
            end

            -- 7. Check Clickable components in active Tab (Toggles, Buttons, Tabs, Textboxes)
            for _, item in ipairs(clickableRegistry) do
                if item.object and isInside(clickX, clickY, item.object) then
                    item.onClick()
                    return
                end
            end
        end
    elseif not gameProcessed and (input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.Insert) then
        toggleMenu()
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        if activeSlider then
            activeSlider.update(input.Position.X)
        elseif isDraggingWM then
            local deltaX = input.Position.X - wmDragStart.X
            local deltaY = input.Position.Y - wmDragStart.Y
            local rawOffset = wmStartOffset + Vector2.new(deltaX, deltaY)
            wmTargetOffset = clampWatermarkOffset(rawOffset)
        elseif isDraggingKB then
            local deltaX = input.Position.X - kbDragStart.X
            local deltaY = input.Position.Y - kbDragStart.Y
            local rawOffset = kbStartOffset + Vector2.new(deltaX, deltaY)
            kbTargetOffset = clampKeybindsOffset(rawOffset)
        elseif isDragging then
            local deltaX = input.Position.X - dragStart.X
            local deltaY = input.Position.Y - dragStart.Y
            local rawOffset = startPos + Vector2.new(deltaX, deltaY)
            targetOffset = clampMainFrameOffset(rawOffset)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = false
        isDraggingWM = false
        isDraggingKB = false
        activeSlider = nil
    end
end)

-- Check if cursor is currently over any DeadHub GUI element
local function isCursorOverMenu()
    local mouse = UserInputService:GetMouseLocation()
    local inset = GuiService:GetGuiInset()
    local curX = mouse.X - inset.X
    local curY = mouse.Y - inset.Y

    if menuOpen and MainFrame.Visible and isInside(curX, curY, MainFrame) then
        return true
    end
    if watermarkEnabled and WatermarkFrame.Visible and isInside(curX, curY, WatermarkFrame) then
        return true
    end
    if keybindsEnabled and KeybindsFrame.Visible and isInside(curX, curY, KeybindsFrame) then
        return true
    end
    return isDragging or isDraggingWM or isDraggingKB
end

-- Watermark Metrics Updater Variables
local fpsFrames = 0
local fpsTimer = 0

-- RenderStepped: Handles Watermark Stats update (0.5s), Snappy & Smooth Dragging, and Background Tool Protection
RunService.RenderStepped:Connect(function(dt)
    -- 1. Watermark Realtime Stats (FPS, Ping, Clock)
    if WatermarkFrame.Visible then
        fpsFrames += 1
        fpsTimer += dt
        if fpsTimer >= 0.5 then
            local currentFPS = math.floor(fpsFrames / fpsTimer)
            WFPSText.Text = tostring(currentFPS) .. " fps"
            fpsFrames = 0
            fpsTimer = 0

            pcall(function()
                local pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
                WPingText.Text = tostring(pingVal) .. " ms"
            end)

            WTimeText.Text = os.date("%H:%M:%S")
        end
    end

    -- 2. Watermark Snappy Smooth Dragging Lerp (Speed 24: fast, responsive & fluid)
    if WatermarkFrame.Visible and watermarkEnabled then
        local wmDiff = wmTargetOffset - wmCurrentOffset
        if wmDiff.Magnitude > 0.2 or isDraggingWM then
            local wmAlpha = 1 - math.exp(-24 * dt)
            wmCurrentOffset = wmCurrentOffset:Lerp(wmTargetOffset, math.clamp(wmAlpha, 0, 1))

            WatermarkFrame.Position = UDim2.fromOffset(
                math.round(wmCurrentOffset.X),
                math.round(wmCurrentOffset.Y)
            )
            wmBasePos = WatermarkFrame.Position
        end
    end

    -- 3. Keybinds Snappy Smooth Dragging Lerp (Speed 24: fast, responsive & fluid)
    if KeybindsFrame.Visible and keybindsEnabled then
        local kbDiff = kbTargetOffset - kbCurrentOffset
        if kbDiff.Magnitude > 0.2 or isDraggingKB then
            local kbAlpha = 1 - math.exp(-24 * dt)
            kbCurrentOffset = kbCurrentOffset:Lerp(kbTargetOffset, math.clamp(kbAlpha, 0, 1))

            KeybindsFrame.Position = UDim2.fromOffset(
                math.round(kbCurrentOffset.X),
                math.round(kbCurrentOffset.Y)
            )
            kbBasePos = KeybindsFrame.Position
        end
    end

    -- 4. Menu Snappy Smooth Lerp Dragging (Speed 18: pure integer pixel rounding, 0 blur)
    if MainFrame.Visible then
        local diff = targetOffset - currentOffset
        if diff.Magnitude > 0.2 or isDragging then
            local alpha = 1 - math.exp(-18 * dt)
            currentOffset = currentOffset:Lerp(targetOffset, math.clamp(alpha, 0, 1))

            MainFrame.Position = UDim2.fromOffset(
                math.round(currentOffset.X),
                math.round(currentOffset.Y)
            )
        end
    end

    -- 5. Background Game Interaction Prevention:
    -- When the cursor is over DeadHub, suppress tool activation (swinging axes, firing weapons)
    local char = LocalPlayer and LocalPlayer.Character
    if char then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            if isCursorOverMenu() then
                if tool:GetAttribute("DH_SavedManual") == nil then
                    tool:SetAttribute("DH_SavedManual", tool.ManualActivationOnly)
                end
                tool.ManualActivationOnly = true
            else
                if tool:GetAttribute("DH_SavedManual") ~= nil then
                    tool.ManualActivationOnly = tool:GetAttribute("DH_SavedManual")
                    tool:SetAttribute("DH_SavedManual", nil)
                end
            end
        end
    end
end)

