    local function open(anchorObj, swatchColor, defaultColor, defaultAlpha, callback)
        if activeColorPicker and activeColorPicker.swatch == anchorObj and Window.Visible then
            Window.Visible = false
            activeColorPicker = nil
            return
        end

        activeColorPicker = {
            swatch = anchorObj,
            swatchColor = swatchColor,
            callback = callback or function() end
        }

        local initColor = defaultColor or Color3.fromRGB(254, 165, 91)
        curH, curS, curV = Color3.toHSV(initColor)
        curA = defaultAlpha ~= nil and math.clamp(defaultAlpha, 0, 1) or 1

        local ap = anchorObj.AbsolutePosition
        local as = anchorObj.AbsoluteSize
        local vp = getViewportSize()

        local targetX = ap.X + as.X + 8
        if targetX + 216 > vp.X - 8 then
            targetX = ap.X - 220
        end
        targetX = math.clamp(targetX, 8, math.max(8, vp.X - 220))
        local targetY = math.clamp(ap.Y - 10, 8, math.max(8, vp.Y - 224))

        Window.Position = UDim2.fromOffset(targetX, targetY)
        Window.Visible = true
        syncUI(false)
    end

    local function close()
        if not Window.Visible then return end
        local r = tonumber(rBox.Text)
        local g = tonumber(gBox.Text)
        local b = tonumber(bBox.Text)
        if r and g and b then
            local newC = Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
            curH, curS, curV = Color3.toHSV(newC)
        end
        local c = hexToRgb(hexBox.Text)
        if c then
            curH, curS, curV = Color3.toHSV(c)
        end
        local cleanA = aBox.Text:gsub("[^%d]", "")
        local n = tonumber(cleanA)
        if n then
            curA = math.clamp(n, 0, 100) / 100
        end
        syncUI(false)

        pcall(function()
            rBox:ReleaseFocus()
            gBox:ReleaseFocus()
            bBox:ReleaseFocus()
            hexBox:ReleaseFocus()
            aBox:ReleaseFocus()
        end)

        Window.Visible = false
        activeColorPicker = nil
        activeColorDrag = nil
    end

    local function handleClick(clickX, clickY)
        if not Window.Visible then return false end

        if isInside(clickX, clickY, Window) then
            if isInside(clickX, clickY, SVCanvas) then
                activeColorDrag = "SV"
                local svPos = SVCanvas.AbsolutePosition
                local svSize = SVCanvas.AbsoluteSize
                curS = math.clamp((clickX - svPos.X) / svSize.X, 0, 1)
                curV = 1 - math.clamp((clickY - svPos.Y) / svSize.Y, 0, 1)
                syncUI()
                return true
            elseif isInside(clickX, clickY, HueBar) then
                activeColorDrag = "HUE"
                local hPos = HueBar.AbsolutePosition
                local hSize = HueBar.AbsoluteSize
                curH = math.clamp((clickX - hPos.X) / hSize.X, 0, 1)
                syncUI()
                return true
            elseif isInside(clickX, clickY, AlphaBar) then
                activeColorDrag = "ALPHA"
                local aPos = AlphaBar.AbsolutePosition
                local aSize = AlphaBar.AbsoluteSize
                curA = math.clamp((clickX - aPos.X) / aSize.X, 0, 1)
                syncUI()
                return true
            elseif isInside(clickX, clickY, rFrame) then
                rBox:CaptureFocus()
                return true
            elseif isInside(clickX, clickY, gFrame) then
                gBox:CaptureFocus()
                return true
            elseif isInside(clickX, clickY, bFrame) then
                bBox:CaptureFocus()
                return true
            elseif isInside(clickX, clickY, hexFrame) then
                hexBox:CaptureFocus()
                return true
            elseif isInside(clickX, clickY, aFrame) then
                aBox:CaptureFocus()
                return true
            end
            return true -- Absorbed
        else
            close()
            return true -- Dismisses color picker and completely absorbs the click
        end
    end

    local function handleDrag(mx, my)
        if not activeColorDrag then return false end
        if activeColorDrag == "SV" then
            local svPos = SVCanvas.AbsolutePosition
            local svSize = SVCanvas.AbsoluteSize
            curS = math.clamp((mx - svPos.X) / svSize.X, 0, 1)
            curV = 1 - math.clamp((my - svPos.Y) / svSize.Y, 0, 1)
            syncUI()
            return true
        elseif activeColorDrag == "HUE" then
            local hPos = HueBar.AbsolutePosition
            local hSize = HueBar.AbsoluteSize
            curH = math.clamp((mx - hPos.X) / hSize.X, 0, 1)
            syncUI()
            return true
        elseif activeColorDrag == "ALPHA" then
            local aPos = AlphaBar.AbsolutePosition
            local aSize = AlphaBar.AbsoluteSize
            curA = math.clamp((mx - aPos.X) / aSize.X, 0, 1)
            syncUI()
            return true
        end
        return false
    end

    return {
        Window = Window,
        Open = open,
        Close = close,
        HandleClick = handleClick,
        HandleDrag = handleDrag,
        EndDrag = function() activeColorDrag = nil end,
        IsDragging = function() return activeColorDrag ~= nil end
    }
end)()

