                ValBox.TextXAlignment = Enum.TextXAlignment.Center
                ValBox.TextYAlignment = Enum.TextYAlignment.Center
                ValBox.ClearTextOnFocus = false
                ValBox.ZIndex = 26
                ValBox.Parent = ValBoxFrame

                -- Permanent Unit Label (Strictly OUTSIDE of the TextBox)
                local cleanSuffix = tostring(suffix or ""):gsub("^%s+", "")
                local UnitLabel = nil
                if cleanSuffix ~= "" then
                    UnitLabel = Instance.new("TextLabel")
                    UnitLabel.Name = "UnitLabel"
                    UnitLabel.Active = false
                    UnitLabel.LayoutOrder = 2
                    UnitLabel.Size = UDim2.new(0, 0, 1, 0)
                    UnitLabel.AutomaticSize = Enum.AutomaticSize.X
                    UnitLabel.BackgroundTransparency = 1
                    UnitLabel.Font = ThemeFontBold
                    UnitLabel.Text = cleanSuffix
                    UnitLabel.TextSize = 11
                    UnitLabel.TextColor3 = Color3.fromRGB(150, 155, 170)
                    UnitLabel.TextXAlignment = Enum.TextXAlignment.Left
                    UnitLabel.TextYAlignment = Enum.TextYAlignment.Center
                    UnitLabel.ZIndex = 26
                    UnitLabel.Parent = ValContainer
                end

                local Track = Instance.new("Frame")
                Track.Name = "Track"
                Track.Active = false
                Track.Size = UDim2.new(1, 0, 0, 6)
                Track.Position = UDim2.new(0, 0, 0, 26)
                Track.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
                Track.BorderSizePixel = 0
                Track.ZIndex = 25
                Track.Parent = Row

                local TrackCorner = Instance.new("UICorner")
                TrackCorner.CornerRadius = UDim.new(0, 3)
                TrackCorner.Parent = Track

                local TrackStroke = Instance.new("UIStroke")
                TrackStroke.Thickness = 1
                TrackStroke.Color = Color3.fromRGB(44, 46, 56)
                TrackStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                TrackStroke.Parent = Track

                local initPct = (max > min) and ((curVal - min) / (max - min)) or 0
                local Fill = Instance.new("Frame")
                Fill.Name = "Fill"
                Fill.Active = false
                Fill.Size = UDim2.new(initPct, 0, 1, 0)
                Fill.BackgroundColor3 = Color3.fromRGB(235, 65, 80)
                Fill.BorderSizePixel = 0
                Fill.ZIndex = 26
                Fill.Parent = Track

                local FillCorner = Instance.new("UICorner")
                FillCorner.CornerRadius = UDim.new(0, 3)
                FillCorner.Parent = Fill

                local Thumb = Instance.new("Frame")
                Thumb.Name = "Thumb"
                Thumb.Active = false
                Thumb.Size = UDim2.new(0, 10, 0, 10)
                Thumb.Position = UDim2.new(initPct, -5, 0.5, -5)
                Thumb.BackgroundColor3 = Color3.fromRGB(245, 245, 250)
                Thumb.BorderSizePixel = 0
                Thumb.ZIndex = 27
                Thumb.Parent = Track

                local ThumbCorner = Instance.new("UICorner")
                ThumbCorner.CornerRadius = UDim.new(0, 3)
                ThumbCorner.Parent = Thumb

                local ThumbStroke = Instance.new("UIStroke")
                ThumbStroke.Thickness = 1
                ThumbStroke.Color = Color3.fromRGB(40, 42, 52)
                ThumbStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                ThumbStroke.Parent = Thumb

                local function countDec(n)
                    if not n or n % 1 == 0 then return 0 end
                    local str = tostring(n)
                    local d = str:match("%.(%d+)")
                    return d and math.min(#d, 3) or 0
                end
                local precision = cfgPrecision or math.max(countDec(min), countDec(max), countDec(defaultVal))
                local mult = 10 ^ precision

                local function setSlider(val)
                    if precision > 0 then
                        curVal = math.clamp(math.round(val * mult) / mult, min, max)
                        ValBox.Text = string.format("%." .. precision .. "f", curVal)
                    else
                        curVal = math.clamp(math.round(val), min, max)
                        ValBox.Text = tostring(curVal)
                    end
                    local pct = (max > min) and ((curVal - min) / (max - min)) or 0
                    Fill.Size = UDim2.new(pct, 0, 1, 0)
                    Thumb.Position = UDim2.new(pct, -5, 0.5, -5)
                    pcall(callback, curVal)
                end

                local function updateSlider(mouseX)
                    local trackPos = Track.AbsolutePosition
                    local trackSize = Track.AbsoluteSize
                    local pct = math.clamp((mouseX - trackPos.X) / trackSize.X, 0, 1)
                    local rawVal = min + (max - min) * pct
                    if precision > 0 then
                        curVal = math.clamp(math.round(rawVal * mult) / mult, min, max)
                        ValBox.Text = string.format("%." .. precision .. "f", curVal)
                    else
                        curVal = math.round(rawVal)
                        ValBox.Text = tostring(curVal)
                    end
                    Fill.Size = UDim2.new(pct, 0, 1, 0)
                    Thumb.Position = UDim2.new(pct, -5, 0.5, -5)
                    pcall(callback, curVal)
                end

                local TrackHitbox = Instance.new("Frame")
                TrackHitbox.Name = "TrackHitbox"
                TrackHitbox.Active = false
                TrackHitbox.Size = UDim2.new(1, 0, 0, 16)
                TrackHitbox.Position = UDim2.new(0, 0, 0, 21)
                TrackHitbox.BackgroundTransparency = 1
                TrackHitbox.ZIndex = 28
                TrackHitbox.Parent = Row

                table.insert(clickableRegistry, {
                    object = TrackHitbox,
                    onClick = function() end,
                    onHover = function(isHovered)
                        TweenService:Create(TrackStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                            Color = isHovered and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(44, 46, 56)
                        }):Play()
                        TweenService:Create(ThumbStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                            Color = isHovered and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(60, 64, 76)
                        }):Play()
                    end
                })

                table.insert(sliderRegistry, {
                    hitbox = TrackHitbox,
                    update = updateSlider
                })

                table.insert(clickableRegistry, {
                    object = ValBoxFrame,
                    onClick = function()
                        ValBox:CaptureFocus()
                    end,
                    onHover = function(isHovered)
                        TweenService:Create(ValBoxFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                            BackgroundColor3 = isHovered and Color3.fromRGB(26, 26, 32) or Color3.fromRGB(20, 20, 24)
                        }):Play()
                        TweenService:Create(ValBoxStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                            Color = isHovered and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(42, 46, 56)
                        }):Play()
                    end
                })

                ValBox.Focused:Connect(function()
                    ValBox.Text = tostring(curVal)
                    TweenService:Create(ValBoxStroke, TweenInfo.new(0.12), {Color = Color3.fromRGB(230, 57, 70)}):Play()
                end)

                ValBox.FocusLost:Connect(function(enterPressed)
                    TweenService:Create(ValBoxStroke, TweenInfo.new(0.12), {Color = Color3.fromRGB(42, 46, 56)}):Play()
                    local clean = ValBox.Text:gsub("[^%d%.%-]", "")
                    local num = tonumber(clean)
                    if num then
                        setSlider(num)
                    else
                        ValBox.Text = tostring(curVal)
                    end
                end)


                configRegistry[sliderName] = {
                    type = "slider",
                    get = function() return curVal end,
                    set = function(v) setSlider(v) end
                }

                return {
                    Row = Row,
                    SetVisible = function(self, vis)
                        Row.Visible = (vis == true)
                    end,
                    GetVisible = function(self)
                        return Row.Visible
                    end,
                    Set = function(self, v) setSlider(v) end,
                    Get = function(self) return curVal end
                }
            end

