local function isInside(x, y, obj)
    if not obj or not obj.Visible then return false end
    local pos = obj.AbsolutePosition
    local size = obj.AbsoluteSize
    if x < pos.X or x > (pos.X + size.X) or y < pos.Y or y > (pos.Y + size.Y) then
        return false
    end
    local curr = obj.Parent
    while curr and curr:IsA("GuiObject") do
        if not curr.Visible then
            return false
        end
        if curr:IsA("ScrollingFrame") or curr.ClipsDescendants then
            local cPos = curr.AbsolutePosition
            local cSize = curr.AbsoluteSize
            if x < cPos.X or x > (cPos.X + cSize.X) or y < cPos.Y or y > (cPos.Y + cSize.Y) then
                return false
            end
        end
        curr = curr.Parent
    end
    return true
end

