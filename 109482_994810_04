            local subEntry = {
                btn = SubBtn,
                stroke = SubBtnStroke,
                text = SubBtnText,
                icon = SubIcon,
                page = SubPage,
                leftScroll = SubLeftScroll,
                rightScroll = SubRightScroll
            }
            table.insert(subtabsList, subEntry)

            local function selectSubTab()
                for _, s in ipairs(subtabsList) do
                    s.btn.BackgroundTransparency = 1
                    s.stroke.Transparency = 1
                    s.text.TextColor3 = Color3.fromRGB(130, 135, 150)
                    s.text.Font = ThemeFont
                    if s.icon then
                        TweenService:Create(s.icon, TweenInfo.new(0.12, Enum.EasingStyle.Quad), {
                            ImageColor3 = Color3.fromRGB(130, 135, 150)
                        }):Play()
                    end
                    s.page.Visible = false
                end

                activeSubTab = subEntry
                SubBtn.BackgroundTransparency = 0
                SubBtn.BackgroundColor3 = Color3.fromRGB(28, 30, 38)
                SubBtnStroke.Transparency = 0
                SubBtnStroke.Color = Color3.fromRGB(48, 52, 66)
                SubBtnText.TextColor3 = Color3.fromRGB(245, 245, 250)
                SubBtnText.Font = ThemeFontBold
                if SubIcon then
                    TweenService:Create(SubIcon, TweenInfo.new(0.12, Enum.EasingStyle.Quad), {
                        ImageColor3 = Color3.fromRGB(230, 57, 70)
                    }):Play()
                end
                SubPage.Visible = true

                -- Route wheel scrolling to active subtab
                tabEntry.leftScroll = SubLeftScroll
                tabEntry.rightScroll = SubRightScroll
            end

            table.insert(clickableRegistry, {
                object = SubBtn,
                onClick = selectSubTab,
                onHover = function(isHovered)
                    if activeSubTab ~= subEntry then
                        TweenService:Create(SubBtn, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                            BackgroundTransparency = isHovered and 0.6 or 1
                        }):Play()
                        TweenService:Create(SubBtnStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                            Transparency = isHovered and 0.5 or 1
                        }):Play()
                        TweenService:Create(SubBtnText, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                            TextColor3 = isHovered and Color3.fromRGB(245, 245, 255) or Color3.fromRGB(130, 135, 150)
                        }):Play()
                        if SubIcon then
                            TweenService:Create(SubIcon, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                                ImageColor3 = isHovered and Color3.fromRGB(230, 235, 250) or Color3.fromRGB(130, 135, 150)
                            }):Play()
                        end
                    end
                end
            })

            if subIndex == 1 then
                selectSubTab()
            end

            local SubTab = {}
            local subColCount = 0

            function SubTab:CreateColumn(colTitle, side, customIcon)
                subColCount += 1
                local target = SubLeftScroll
                if side == "right" or (side == nil and subColCount % 2 == 0) then
                    target = SubRightScroll
                end
                return createColumnInternal(target, colTitle, customIcon)
            end

            return SubTab
        end

        return Tab
    end

    return Window
end

if getgenv then
    getgenv().DeadHub = DeadHub
end

return DeadHub
