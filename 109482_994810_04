-- Keybind & Input Helper Functions (Linoria Architecture & Bloxstrike Safe)
local function formatKeyName(key)
    if not key or key == "None" or key == "" then return "None" end
    if key == Enum.UserInputType.MouseButton1 then return "MB1" end
    if key == Enum.UserInputType.MouseButton2 then return "MB2" end
    if key == Enum.UserInputType.MouseButton3 then return "MB3" end
    if key == "WheelUp" then return "WheelUp" end
    if key == "WheelDown" then return "WheelDown" end
    if typeof(key) == "EnumItem" then
        local n = key.Name
        if n == "RightShift" then return "RShift" end
        if n == "LeftShift" then return "LShift" end
        if n == "RightControl" then return "RCtrl" end
        if n == "LeftControl" then return "LCtrl" end
        if n == "RightAlt" then return "RAlt" end
        if n == "LeftAlt" then return "LAlt" end
        if n == "CapsLock" then return "Caps" end
        if n == "Backquote" then return "`" end
        if n == "Minus" then return "-" end
        if n == "Equals" then return "=" end
        if n == "LeftBracket" then return "[" end
        if n == "RightBracket" then return "]" end
        if n == "BackSlash" then return "\\" end
        if n == "Semicolon" then return ";" end
        if n == "Quote" then return "'" end
        if n == "Comma" then return "," end
        if n == "Period" then return "." end
        if n == "Slash" then return "/" end
        if n == "PageUp" then return "PgUp" end
        if n == "PageDown" then return "PgDn" end
        if n == "Delete" then return "Del" end
        if n == "Insert" then return "Ins" end
        return n
    end
    return tostring(key)
end

local function formatKeyBadge(key)
    local n = formatKeyName(key)
    if n == "None" then return "[-]" end
    return "[" .. n .. "]"
end

local function isKeyPhysicallyDown(key)
    if not key then return false end
    if key == Enum.UserInputType.MouseButton1 or key == Enum.UserInputType.MouseButton2 or key == Enum.UserInputType.MouseButton3 then
        return UserInputService:IsMouseButtonPressed(key)
    elseif typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then
        return UserInputService:IsKeyDown(key)
    end
    return false
end

local function isTyping()
    if UserInputService:GetFocusedTextBox() ~= nil then
        return true
    end
    if GuiService.MenuIsOpen then
        return true
    end
    return false
end

