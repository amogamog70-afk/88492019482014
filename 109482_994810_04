--[[
    DeadHub UI Library - Trident Survival Safe Edition
    Architecture: Zero-GPE (Zero GameProcessedEvent)
    Security: Completely passive elements, no TextButton/ImageButton, Active = false
    Style: Classic Sharp Square / Clean Minimal 1px Outline
]]

local cloneref = cloneref or function(o) return o end
local CoreGui = cloneref(game:GetService("CoreGui"))
local Players = cloneref(game:GetService("Players"))
local UserInputService = cloneref(game:GetService("UserInputService"))
local RunService = cloneref(game:GetService("RunService"))
local Stats = cloneref(game:GetService("Stats"))
local TweenService = cloneref(game:GetService("TweenService"))
local GuiService = cloneref(game:GetService("GuiService"))

local LocalPlayer = Players.LocalPlayer

-- Resolve safe container (gethui with fallback)
local parentContainer = nil
if gethui then
    parentContainer = gethui()
else
    local success, res = pcall(function() return CoreGui end)
    if success and res then
        parentContainer = res
    else
        parentContainer = LocalPlayer:WaitForChild("PlayerGui")
    end
end

-- DeadHub Library Interface
local DeadHub = {}
DeadHub.__index = DeadHub

function DeadHub:CreateWindow(config)
    config = config or {}
    local windowTitle = config.Title or config.Name or '<font color="#e63946">Dead</font>Hub'
    local windowSubtitle = config.Subtitle or config.SubTitle or "TRIDENT SURVIVAL"

    -- Clean up any existing DeadHub instances
    if parentContainer then
        for _, child in ipairs(parentContainer:GetChildren()) do
            if child.Name:sub(1, 8) == "DeadHub_" then
                pcall(function() child:Destroy() end)
            end
        end
    end

    -- ScreenGui Setup
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "DeadHub_" .. tostring(math.random(100000, 999999))
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.DisplayOrder = 999
    ScreenGui.Parent = parentContainer

