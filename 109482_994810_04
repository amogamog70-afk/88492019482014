                local Label = Instance.new("TextLabel")
                Label.Name = "Label"
                Label.Active = false
                Label.Size = UDim2.new(0.55, 0, 0, 18)
                Label.Position = UDim2.new(0, 0, 0, 0)
                Label.BackgroundTransparency = 1
                Label.Font = ThemeFont
                Label.Text = graphName
                Label.TextSize = 13
                Label.TextColor3 = Color3.fromRGB(215, 220, 230)
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.TextYAlignment = Enum.TextYAlignment.Center
                Label.ZIndex = 25
                Label.Parent = Row

                local CoordLabel = Instance.new("TextLabel")
                CoordLabel.Name = "CoordLabel"
                CoordLabel.Active = false
                CoordLabel.Size = UDim2.new(0.45, 0, 0, 18)
                CoordLabel.Position = UDim2.new(0.55, 0, 0, 0)
                CoordLabel.BackgroundTransparency = 1
                CoordLabel.Font = ThemeFont
                CoordLabel.Text = "Drag points to edit"
                CoordLabel.TextSize = 10
                CoordLabel.TextColor3 = Color3.fromRGB(150, 155, 170)
                CoordLabel.TextXAlignment = Enum.TextXAlignment.Right
                CoordLabel.TextYAlignment = Enum.TextYAlignment.Center
                CoordLabel.ZIndex = 25
                CoordLabel.Parent = Row

                local Canvas = Instance.new("Frame")
                Canvas.Name = "Canvas"
                Canvas.Active = false
                Canvas.Size = UDim2.new(1, 0, 0, 112)
                Canvas.Position = UDim2.new(0, 0, 0, 22)
                Canvas.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
                Canvas.BorderSizePixel = 0
                Canvas.ClipsDescendants = true
                Canvas.ZIndex = 25
                Canvas.Parent = Row

                local cCorner = Instance.new("UICorner")
                cCorner.CornerRadius = UDim.new(0, 4)
                cCorner.Parent = Canvas

                local cStroke = Instance.new("UIStroke")
                cStroke.Thickness = 1
                cStroke.Color = Color3.fromRGB(40, 42, 52)
                cStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                cStroke.Parent = Canvas

                -- Subtle grid lines
                for frac = 0.25, 0.75, 0.25 do
                    local hLine = Instance.new("Frame")
                    hLine.Name = "GridH_" .. tostring(frac)
                    hLine.Active = false
                    hLine.Size = UDim2.new(1, 0, 0, 1)
                    hLine.Position = UDim2.new(0, 0, frac, 0)
                    hLine.BackgroundColor3 = Color3.fromRGB(28, 30, 36)
                    hLine.BorderSizePixel = 0
                    hLine.ZIndex = 26
                    hLine.Parent = Canvas

                    local vLine = Instance.new("Frame")
                    vLine.Name = "GridV_" .. tostring(frac)
                    vLine.Active = false
                    vLine.Size = UDim2.new(0, 1, 1, 0)
                    vLine.Position = UDim2.new(frac, 0, 0, 0)
                    vLine.BackgroundColor3 = Color3.fromRGB(28, 30, 36)
                    vLine.BorderSizePixel = 0
                    vLine.ZIndex = 26
                    vLine.Parent = Canvas
                end

                local lineSegments = {}
                local nodeFrames = {}

                for i = 1, #points - 1 do
                    local line = Instance.new("Frame")
                    line.Name = "Line_" .. tostring(i)
                    line.Active = false
                    line.BackgroundColor3 = Color3.fromRGB(230, 57, 70)
                    line.BorderSizePixel = 0
                    line.AnchorPoint = Vector2.new(0.5, 0.5)
                    line.ZIndex = 27
                    line.Parent = Canvas
                    lineSegments[i] = line
                end

                for i = 1, #points do
                    local node = Instance.new("Frame")
                    node.Name = "Node_" .. tostring(i)
                    node.Active = false
                    node.Size = UDim2.new(0, 8, 0, 8)
                    node.AnchorPoint = Vector2.new(0.5, 0.5)
                    node.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    node.BorderSizePixel = 0
                    node.ZIndex = 28
                    node.Parent = Canvas

                    local nCorner = Instance.new("UICorner")
                    nCorner.CornerRadius = UDim.new(0, 4)
                    nCorner.Parent = node

                    nodeFrames[i] = node
                end

                local padX = 12
                local padY = 12

                local function renderGraph()
                    local cSize = Canvas.AbsoluteSize
                    local w = math.max(10, cSize.X - padX * 2)
                    local h = math.max(10, cSize.Y - padY * 2)

                    local pixelPositions = {}
                    for i, pt in ipairs(points) do
                        local px = padX + pt[1] * w
                        local normY = (pt[2] - minY) / math.max(1, maxY - minY)
                        local py = cSize.Y - (padY + normY * h)
                        pixelPositions[i] = Vector2.new(px, py)

                        local node = nodeFrames[i]
                        node.Position = UDim2.fromOffset(px, py)
                        if activePointIdx == i then
                            node.BackgroundColor3 = Color3.fromRGB(230, 57, 70)
                            node.Size = UDim2.new(0, 10, 0, 10)
                        else
                            node.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                            node.Size = UDim2.new(0, 8, 0, 8)
                        end
                    end

                    for i = 1, #points - 1 do
                        local p1 = pixelPositions[i]
                        local p2 = pixelPositions[i + 1]
                        local dx = p2.X - p1.X
                        local dy = p2.Y - p1.Y
                        local dist = math.sqrt(dx * dx + dy * dy)
                        local angle = math.deg(math.atan2(dy, dx))
                        local midX = (p1.X + p2.X) / 2
                        local midY = (p1.Y + p2.Y) / 2

                        local line = lineSegments[i]
                        line.Size = UDim2.fromOffset(dist, 2)
                        line.Position = UDim2.fromOffset(midX, midY)
                        line.Rotation = angle
                    end
                end

                task.defer(renderGraph)
                Canvas:GetPropertyChangedSignal("AbsoluteSize"):Connect(renderGraph)

                local activePointIdx = nil

                local function handleGraphDrag(mx, my)
                    if not activePointIdx then return end
                    local cPos = Canvas.AbsolutePosition
                    local cSize = Canvas.AbsoluteSize
                    local w = math.max(10, cSize.X - padX * 2)
                    local h = math.max(10, cSize.Y - padY * 2)

                    local relX = math.clamp((mx - cPos.X - padX) / w, 0, 1)
                    local relY = math.clamp((cSize.Y - (my - cPos.Y) - padY) / h, 0, 1)
                    local valY = minY + relY * (maxY - minY)

                    if activePointIdx == 1 then
                        relX = 0
                    elseif activePointIdx == #points then
                        relX = 1
                    else
                        local minX = points[activePointIdx - 1][1] + 0.02
                        local maxX = points[activePointIdx + 1][1] - 0.02
                        relX = math.clamp(relX, minX, maxX)
                    end

                    points[activePointIdx][1] = relX
                    points[activePointIdx][2] = math.floor(valY * 10 + 0.5) / 10

                    CoordLabel.Text = string.format("P%d: [X: %.2f, Y: %.1f]", activePointIdx, relX, points[activePointIdx][2])
                    renderGraph()
                    pcall(callback, points)
                end

                table.insert(clickableRegistry, {
                    object = Canvas,
                    onClick = function(clickX, clickY)
                        local cPos = Canvas.AbsolutePosition
                        local cSize = Canvas.AbsoluteSize
                        local w = math.max(10, cSize.X - padX * 2)
                        local h = math.max(10, cSize.Y - padY * 2)

                        local nearestIdx = 1
                        local nearestDist = 9999
                        for i, pt in ipairs(points) do
                            local px = cPos.X + padX + pt[1] * w
                            local normY = (pt[2] - minY) / math.max(1, maxY - minY)
                            local py = cPos.Y + cSize.Y - (padY + normY * h)
                            local d = math.sqrt((clickX - px) ^ 2 + (clickY - py) ^ 2)
                            if d < nearestDist then
                                nearestDist = d
                                nearestIdx = i
                            end
                        end

                        activePointIdx = nearestIdx
                        activeGraphDrag = {
                            update = handleGraphDrag,
                            finish = function()
                                activePointIdx = nil
                                renderGraph()
                            end
                        }
                        handleGraphDrag(clickX, clickY)
                    end,
                    onHover = function(isHov)
                        TweenService:Create(cStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                            Color = isHov and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 42, 52)
                        }):Play()
                    end
                })

                configRegistry[graphName] = {
                    type = "graph",
                    get = function() return points end,
                    set = function(newPoints)
                        if type(newPoints) == "table" and #newPoints == #points then
                            for i, p in ipairs(newPoints) do
                                points[i][1] = math.clamp(p[1], 0, 1)
                                points[i][2] = math.clamp(p[2], minY, maxY)
                            end
                            renderGraph()
                            pcall(callback, points)
                        end
                    end
                }

                return {
                    Set = function(self, newPoints)
                        if type(newPoints) == "table" and #newPoints == #points then
                            for i, p in ipairs(newPoints) do
                                points[i][1] = math.clamp(p[1], 0, 1)
                                points[i][2] = math.clamp(p[2], minY, maxY)
                            end
                            renderGraph()
                            pcall(callback, points)
                        end
                    end,
                    Get = function(self)
                        return points
                    end
                }
            end

            return Column
        end

