                ValBoxFrame.Active = false
                ValBoxFrame.LayoutOrder = 1
                ValBoxFrame.Size = UDim2.new(0, 36, 0, 20)
                ValBoxFrame.AutomaticSize = Enum.AutomaticSize.X
                ValBoxFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
                ValBoxFrame.BorderSizePixel = 0
                ValBoxFrame.ZIndex = 25
                ValBoxFrame.Parent = ValContainer

                local ValBoxCorner = Instance.new("UICorner")
                ValBoxCorner.CornerRadius = UDim.new(0, 3)
                ValBoxCorner.Parent = ValBoxFrame

                local ValBoxStroke = Instance.new("UIStroke")
                ValBoxStroke.Thickness = 1
                ValBoxStroke.Color = Color3.fromRGB(42, 46, 56)
                ValBoxStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                ValBoxStroke.Parent = ValBoxFrame

                local ValBoxPadding = Instance.new("UIPadding")
                ValBoxPadding.PaddingLeft = UDim.new(0, 6)
                ValBoxPadding.PaddingRight = UDim.new(0, 6)
                ValBoxPadding.Parent = ValBoxFrame

                local ValBox = Instance.new("TextBox")
                ValBox.Name = "ValBox"
                ValBox.Active = false
                ValBox.Size = UDim2.new(1, 0, 1, 0)
                ValBox.AutomaticSize = Enum.AutomaticSize.X
                ValBox.BackgroundTransparency = 1
                ValBox.Font = ThemeFontBold
                ValBox.Text = tostring(curVal)
                ValBox.TextSize = 11
