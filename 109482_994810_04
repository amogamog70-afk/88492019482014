-- Interactive Zero-GPE Component Registries (Declared early for keybind entries)
local clickableRegistry = {}
local sliderRegistry = {}
local rightClickRegistry = {}
local keybindItems = {}

local function updateKeybindsLayout()
    local hasItems = next(keybindItems) ~= nil
    KBDivider.Visible = hasItems
    KBListContainer.Visible = hasItems
end

local function addKeybindEntry(id, name, mode, isActive, keyName)
    local row = Instance.new("Frame")
    row.Name = "KBRow_" .. id
    row.Active = false
    row.Size = UDim2.new(1, 0, 0, 16)
    row.BackgroundTransparency = 1
    row.ZIndex = 102
    row.Parent = KBListContainer

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Name = "NameLbl"
    nameLbl.Active = false
    nameLbl.Size = UDim2.new(1, -78, 1, 0)
    nameLbl.Position = UDim2.new(0, 0, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Font = ThemeFont
    nameLbl.Text = name
    nameLbl.TextSize = 12
    nameLbl.TextColor3 = Color3.fromRGB(200, 205, 218)
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left
    nameLbl.TextYAlignment = Enum.TextYAlignment.Center
    nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
    nameLbl.ZIndex = 103
    nameLbl.Parent = row

    local modeBadge = Instance.new("TextLabel")
    modeBadge.Name = "ModeBadge"
    modeBadge.Active = false
    modeBadge.Size = UDim2.new(0, 75, 1, 0)
    modeBadge.Position = UDim2.new(1, -75, 0, 0)
    modeBadge.BackgroundTransparency = 1
    modeBadge.Font = ThemeFontBold

    local badgeText = ""
    if keyName and keyName ~= "" and keyName ~= "None" then
        badgeText = "[" .. keyName .. " | " .. string.lower(mode) .. "]"
    else
        badgeText = "[" .. string.lower(mode) .. "]"
    end

    modeBadge.Text = badgeText
    modeBadge.TextSize = 11
    modeBadge.TextColor3 = isActive and Color3.fromRGB(230, 57, 70) or Color3.fromRGB(120, 125, 140)
    modeBadge.TextXAlignment = Enum.TextXAlignment.Right
    modeBadge.TextYAlignment = Enum.TextYAlignment.Center
    modeBadge.ZIndex = 103
    modeBadge.Parent = row

    local lastKbRowClick = 0
    table.insert(clickableRegistry, {
        object = row,
        onClick = function()
            local now = tick()
            if (now - lastKbRowClick) < 0.35 then
                -- Double-click on keybind widget row removes the keybind
                lastKbRowClick = 0
                for _, t in ipairs(rightClickRegistry) do
                    if t.id == id and t.resetKeybind then
                        t.resetKeybind()
                        break
                    end
                end
                removeKeybindEntry(id)
                return
            end
            lastKbRowClick = now
        end
    })

    keybindItems[id] = {frame = row, nameLbl = nameLbl, modeBadge = modeBadge, keyName = keyName}
    updateKeybindsLayout()
    return row
end

local function removeKeybindEntry(id)
    if keybindItems[id] then
        pcall(function() keybindItems[id].frame:Destroy() end)
        keybindItems[id] = nil
        updateKeybindsLayout()
    end
end

-- Dynamic Viewport Screen Size Helper
local function getViewportSize()
    local cam = workspace.CurrentCamera
    if cam and cam.ViewportSize.X > 0 and cam.ViewportSize.Y > 0 then
        return cam.ViewportSize
    end
    if ScreenGui and ScreenGui.AbsoluteSize.X > 0 then
        return ScreenGui.AbsoluteSize
    end
    return Vector2.new(1920, 1080)
end

