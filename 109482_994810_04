                    local cfg = sliderName
                    sliderName = cfg.Name or "Slider"
                    min = cfg.Min or 0
                    max = cfg.Max or 100
                    defaultVal = cfg.Default or min
                    arg5 = cfg.Suffix or ""
                    arg6 = cfg.Callback or cfg.callback
                    cfgPrecision = cfg.Precision or cfg.Decimals
                end

                min = min or 0
                max = max or 100
                defaultVal = math.clamp(defaultVal or min, min, max)

                local suffix = ""
                local callback = nil
                if type(arg5) == "string" then
                    suffix = arg5
                    callback = arg6 or function() end
                elseif type(arg5) == "function" then
                    callback = arg5
                    if type(arg6) == "string" then
