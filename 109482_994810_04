    function Window:SaveConfig(name)
        if not name or name == "" then return false end
        local data = {}
        for k, item in pairs(configRegistry) do
            pcall(function()
                data[k] = item.get()
            end)
        end
                data["_Keybinds"] = {}
        local success, json = pcall(function()
            return HttpService:JSONEncode(data)
        end)
        if not success then return false end

        local saved = false
        if writefile then
            pcall(function()
                if isfolder and not isfolder("DeadHub") then makefolder("DeadHub") end
                if isfolder and not isfolder("DeadHub/Configs") then makefolder("DeadHub/Configs") end
                writefile("DeadHub/Configs/" .. tostring(name) .. ".json", json)
                saved = true
            end)
        end
        if not saved then
            inMemoryConfigs[name] = json
        end
        return true
    end

    function Window:LoadConfig(name)
        if not name or name == "" then return false end
        local json = nil
        if readfile then
            pcall(function()
                if isfile and isfile("DeadHub/Configs/" .. tostring(name) .. ".json") then
                    json = readfile("DeadHub/Configs/" .. tostring(name) .. ".json")
                elseif isfile and isfile("DeadHub/Configs/" .. tostring(name)) then
                    json = readfile("DeadHub/Configs/" .. tostring(name))
                end
            end)
        end
        if not json and inMemoryConfigs[name] then
            json = inMemoryConfigs[name]
        end
        if not json then return false end

        local success, data = pcall(function()
            return HttpService:JSONDecode(json)
        end)
        if not success or type(data) ~= "table" then return false end

        for k, val in pairs(data) do
            if k ~= "_Keybinds" and configRegistry[k] and configRegistry[k].set then
                pcall(function()
                    configRegistry[k].set(val)
                end)
            end
        end

        
        return true
    end

    function Window:DeleteConfig(name)
        if not name or name == "" then return false end
        local deleted = false
        if delfile then
            pcall(function()
                if isfile and isfile("DeadHub/Configs/" .. tostring(name) .. ".json") then
                    delfile("DeadHub/Configs/" .. tostring(name) .. ".json")
                    deleted = true
                end
            end)
        end
        if inMemoryConfigs[name] then
            inMemoryConfigs[name] = nil
            deleted = true
        end
        return deleted
    end

    function Window:GetConfigs()
        local list = {}
        if listfiles then
            pcall(function()
                if isfolder and isfolder("DeadHub/Configs") then
                    for _, f in ipairs(listfiles("DeadHub/Configs")) do
                        local clean = f:gsub("DeadHub/Configs/", ""):gsub("%.json$", ""):gsub("\\", "/")
                        clean = clean:match("([^/]+)$") or clean
                        table.insert(list, clean)
                    end
                end
            end)
        end
        for k, _ in pairs(inMemoryConfigs) do
            local found = false
            for _, item in ipairs(list) do
                if item == k then found = true break end
            end
            if not found then table.insert(list, k) end
        end
        return list
    end

