    modeBadge.Text = "[" .. mode .. "]"
    modeBadge.TextSize = 9
    modeBadge.TextColor3 = isActive and Color3.fromRGB(230, 57, 70) or Color3.fromRGB(120, 125, 140)
    modeBadge.TextXAlignment = Enum.TextXAlignment.Right
    modeBadge.TextYAlignment = Enum.TextYAlignment.Center
    modeBadge.ZIndex = 103
    modeBadge.Parent = row

    keybindItems[id] = {frame = row, nameLbl = nameLbl, modeBadge = modeBadge}
    updateKeybindsLayout()
    return row
end

local function removeKeybindEntry(id)
    if keybindItems[id] then
        pcall(function() keybindItems[id].frame:Destroy() end)
        keybindItems[id] = nil
        updateKeybindsLayout()
    end
end

-- Dynamic Viewport Screen Size Helper
local function getViewportSize()
    local cam = workspace.CurrentCamera
    if cam and cam.ViewportSize.X > 0 and cam.ViewportSize.Y > 0 then
        return cam.ViewportSize
    end
    if ScreenGui and ScreenGui.AbsoluteSize.X > 0 then
        return ScreenGui.AbsoluteSize
    end
    return Vector2.new(1920, 1080)
end

