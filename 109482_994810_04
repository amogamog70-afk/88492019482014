                            Color = isHovered and (state and Color3.fromRGB(255, 110, 125) or Color3.fromRGB(80, 86, 106)) or Color3.fromRGB(50, 54, 66)
                        }):Play()
                        if not state then
                            TweenService:Create(Switch, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {
                                BackgroundColor3 = isHovered and Color3.fromRGB(36, 36, 44) or Color3.fromRGB(28, 28, 34)
                            }):Play()
                        end
                    end
                })

                local function registerRightClick()
                    table.insert(rightClickRegistry, {
                        id = toggleId,
                        object = Row,
                        name = toggleName,
                        resetKeybind = resetKeybind,
                        getMode = function() return mode end,
                        setMode = function(newMode)
                            mode = newMode
                            if mode == "always" then
                                setToggle(true)
                            end
                            updateKeybindDisplay()
                        end,
                        getKey = function() return boundKey end,
                        setKey = function(newKey)
                            boundKey = newKey
                            updateKeybindDisplay()
                        end,
                        toggle = function()
                            if mode == "toggle" then
                                setToggle(not state)
                            end
                        end,
                        set = function(val)
                            if mode ~= "always" then
                                setToggle(val)
                            end
                        end
                    })
                end

                if hasKeybind then
                    registerRightClick()
                    updateKeybindDisplay()
                end

                local toggleObj = {
                    Set = function(self, val) setToggle(val) end,
                    Get = function(self) return state end,
                    AddKeybind = function(self, k, m)
                        if not hasKeybind then
                            hasKeybind = true
                            if k then boundKey = k end
                            if m then mode = m end
                            registerRightClick()
                            updateKeybindDisplay()
                        end
                        return self
                    end,
                    SetKey = function(self, k)
                        if not hasKeybind then
                            self:AddKeybind(k)
                        else
                            boundKey = k
                            updateKeybindDisplay()
                        end
                    end,
                    SetMode = function(self, m)
                        if not hasKeybind then
                            self:AddKeybind(nil, m)
                        else
                            mode = m
                            if m == "always" then setToggle(true) else updateKeybindDisplay() end
                        end
                    end
                }

                return toggleObj
            end

