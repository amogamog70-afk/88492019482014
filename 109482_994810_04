                    return true
                end
            end
            return true
        else
            close()
            return true
        end
    end

    local function handleHover(mx, my)
        if not Window.Visible then return false end
        if not isInside(mx, my, Window) then return false end
        for _, it in ipairs(items) do
            local hov = isInside(mx, my, it.frame)
            if not isMulti then
                local isSel = (currentVal == it.name)
                if not isSel then
                    it.stroke.Color = hov and Color3.fromRGB(60, 65, 80) or Color3.fromRGB(38, 40, 48)
                    it.frame.BackgroundColor3 = hov and Color3.fromRGB(32, 34, 42) or Color3.fromRGB(24, 24, 28)
                    it.text.TextColor3 = hov and Color3.fromRGB(230, 235, 245) or Color3.fromRGB(150, 155, 170)
                end
            else
                local isSel = (currentVal[it.name] == true)
                if not isSel then
                    it.frame.BackgroundColor3 = hov and Color3.fromRGB(32, 34, 42) or Color3.fromRGB(24, 24, 28)
                    it.text.TextColor3 = hov and Color3.fromRGB(230, 235, 245) or Color3.fromRGB(150, 155, 170)
                end
            end
        end
        return true
    end

    local function handleWheel(deltaZ)
        if not Window.Visible then return false end
        local maxScroll = math.max(0, Scroll.CanvasSize.Y.Offset - Scroll.AbsoluteWindowSize.Y)
        local newY = math.clamp(Scroll.CanvasPosition.Y - deltaZ * 24, 0, maxScroll)
        Scroll.CanvasPosition = Vector2.new(0, newY)
        return true
    end

    return {
        Window = Window,
        Open = open,
        Close = close,
        HandleClick = handleClick,
        HandleHover = handleHover,
        HandleWheel = handleWheel,
        IsVisible = function() return Window.Visible end
    }
end)()

