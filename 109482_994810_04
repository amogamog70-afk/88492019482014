                ValContainer.ZIndex = 25
                ValContainer.Parent = Row

                local ValContainerLayout = Instance.new("UIListLayout")
                ValContainerLayout.FillDirection = Enum.FillDirection.Horizontal
                ValContainerLayout.VerticalAlignment = Enum.VerticalAlignment.Center
                ValContainerLayout.SortOrder = Enum.SortOrder.LayoutOrder
