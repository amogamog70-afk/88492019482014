local menuOpen = true
local activeScaleTween = nil

local function toggleMenu(show)
    if show == nil then
        show = not menuOpen
    end
    menuOpen = show

    if activeScaleTween then activeScaleTween:Cancel() end

    if menuOpen then
        MainFrame.Visible = true
        MainScale.Scale = 0.96
        activeScaleTween = TweenService:Create(MainScale, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1.0})
        activeScaleTween:Play()
    else
        isDragging = false
        activeScaleTween = TweenService:Create(MainScale, TweenInfo.new(0.14, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Scale = 0.96})
        activeScaleTween:Play()

        -- Reset all hover states when closing menu
        for _, item in ipairs(clickableRegistry) do
            if item._isHovered then
                item._isHovered = false
                if item.onHover then
                    pcall(item.onHover, false)
                end
            end
        end

        if SettingsPopup then
            SettingsPopup.Visible = false
        end

        if ColorPicker then
            ColorPicker.Close()
        end

        if DropdownOverlay then
            DropdownOverlay.Close()
        end

        if ContextMenu then
            ContextMenu.Visible = false
            isListeningKeybind = false
            activeContextItem = nil
        end

        if isListeningMenuKey then
            isListeningMenuKey = false
            updateMenuKeyUI()
        end

        if Mouse then
            pcall(function() Mouse.Icon = "" end)
        end

        task.delay(0.14, function()
            if not menuOpen then
                MainFrame.Visible = false
            end
        end)
    end
end

