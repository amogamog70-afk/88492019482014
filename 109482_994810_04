-- Unified single InputBegan handler (Linoria Architecture & Bloxstrike Safe)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- 0. Check Menu Toggle Key (RightShift, Insert, or custom menuKey)
    local isMenuToggle = false
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if (menuKey and input.KeyCode == menuKey) or input.KeyCode == Enum.KeyCode.Insert then
            isMenuToggle = true
        end
    end
    if isMenuToggle then
        if not isTyping() then
            toggleMenu()
            return
        end
    end

    -- 1. Listening for custom Menu Key (Settings popup)
    if isListeningMenuKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            pcall(function()
                if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                    menuKey = nil
                elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                    menuKey = input.KeyCode
                end
            end)
            isListeningMenuKey = false
            updateMenuKeyUI()
            return
        end
    end

    -- 2. Listening for Keybind on element
    if isListeningKeybind and activeContextItem then
        local cancelled = false
        local cleared = false
        local bound = nil

        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.Escape then
                cancelled = true
            elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
                cleared = true
            elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                bound = input.KeyCode
            end
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            bound = Enum.UserInputType.MouseButton2
        elseif input.UserInputType == Enum.UserInputType.MouseButton3 then
            bound = Enum.UserInputType.MouseButton3
        elseif input.UserInputType == Enum.UserInputType.MouseWheel then
            if input.Position.Z > 0 then
                bound = "WheelUp"
            elseif input.Position.Z < 0 then
                bound = "WheelDown"
            end
        end

        if cancelled then
            isListeningKeybind = false
            if activeContextItem.updateDisplay then activeContextItem.updateDisplay() end
            activeContextItem = nil
            return
        elseif cleared then
            if activeContextItem.setKey then activeContextItem.setKey(nil) end
            isListeningKeybind = false
            if activeContextItem.updateDisplay then activeContextItem.updateDisplay() end
            activeContextItem = nil
            return
        elseif bound ~= nil then
            if activeContextItem.setKey then activeContextItem.setKey(bound) end
            isListeningKeybind = false
            if activeContextItem.updateDisplay then activeContextItem.updateDisplay() end
            activeContextItem = nil
            return
        end
    end

    -- 3. MouseButton1 Clicks (UI Interactions & Hit-Tests)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local clickX = input.Position.X
        local clickY = input.Position.Y

        -- Priority 0: Watermark dragging
        if WatermarkFrame.Visible and watermarkEnabled and isInside(clickX, clickY, WatermarkFrame) then
            isDraggingWM = true
            wmDragStart = Vector2.new(clickX, clickY)
            wmStartOffset = Vector2.new(WatermarkFrame.Position.X.Offset, WatermarkFrame.Position.Y.Offset)
            wmCurrentOffset = wmStartOffset
            wmTargetOffset = wmStartOffset
            return
        end

        -- Priority 1: Keybinds widget dragging
        if KeybindsFrame and KeybindsFrame.Visible and keybindsEnabled and isInside(clickX, clickY, KeybindsFrame) then
            isDraggingKB = true
            kbDragStart = Vector2.new(clickX, clickY)
            kbStartOffset = Vector2.new(KeybindsFrame.Position.X.Offset, KeybindsFrame.Position.Y.Offset)
            kbCurrentOffset = kbStartOffset
            kbTargetOffset = kbStartOffset
            return
        end

        -- Priority 2: ColorPicker Window
        if ColorPicker.Window.Visible then
            if ColorPicker.HandleClick(clickX, clickY) then
                return
            end
        end

        -- Priority 3: Dropdown & Multiselect Overlay
        if DropdownOverlay.IsVisible() then
            if DropdownOverlay.HandleClick(clickX, clickY) then
                return
            end
        end

        -- Priority 4: Mode Context Menu Modal
        if ModeContextMenu.Visible then
            if isInside(clickX, clickY, ModeContextMenu) then
                for mName, mObj in pairs(modeButtons) do
                    if isInside(clickX, clickY, mObj.row) then
                        if activeContextItem and activeContextItem.setMode then
                            activeContextItem.setMode(mName)
                        end
                        ModeContextMenu.Visible = false
                        activeContextItem = nil
                        return
                    end
                end
                return
            else
                ModeContextMenu.Visible = false
                activeContextItem = nil
            end
        end

        -- Priority 5: MainFrame interactions when menuOpen
        if MainFrame.Visible and menuOpen then
            -- Settings popup
            if SettingsPopup and SettingsPopup.Visible then
                if isInside(clickX, clickY, SettingsPopup) then
                    if isInside(clickX, clickY, WatermarkRow) then
                        toggleWatermark()
                        return
                    elseif isInside(clickX, clickY, KeybindsToggleRow) then
                        toggleKeybinds()
                        return
                    elseif isInside(clickX, clickY, KeybindRow) then
                        isListeningMenuKey = not isListeningMenuKey
                        updateMenuKeyUI()
                        return
                    end
                    return
                else
                    SettingsPopup.Visible = false
                    if isListeningMenuKey then
                        isListeningMenuKey = false
                        updateMenuKeyUI()
                    end
                    if isInside(clickX, clickY, ThreeDotsBtn) then
                        return
                    end
                end
            end

            -- 3 dots button
            if isInside(clickX, clickY, ThreeDotsBtn) then
                if SettingsPopup then
                    SettingsPopup.Visible = true
                end
                return
            end

            -- Header dragging
            if isInside(clickX, clickY, Header) then
                isDragging = true
                dragStart = Vector2.new(clickX, clickY)
                startPos = Vector2.new(MainFrame.Position.X.Offset, MainFrame.Position.Y.Offset)
                currentOffset = startPos
                targetOffset = startPos
                return
            end

            -- Active Sliders
            for _, s in ipairs(sliderRegistry) do
                if s.hitbox and isInside(clickX, clickY, s.hitbox) then
                    activeSlider = s
                    s.update(clickX)
                    return
                end
            end

            -- Clickable components (reverse order so inner buttons take priority)
            for i = #clickableRegistry, 1, -1 do
                local item = clickableRegistry[i]
                if item.object and isInside(clickX, clickY, item.object) then
                    if item.onClick then
                        pcall(item.onClick, clickX, clickY)
                    end
                    return
                end
            end
        end

        return
    end

    -- 4. MouseButton2 (Right-Click Context Menu opener on keybind buttons)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        local clickX = input.Position.X
        local clickY = input.Position.Y

        if ColorPicker.Window.Visible then ColorPicker.Close() end
        if DropdownOverlay.IsVisible() then DropdownOverlay.Close() end
        if SettingsPopup and SettingsPopup.Visible then SettingsPopup.Visible = false end

        if MainFrame.Visible and menuOpen then
            for _, item in ipairs(keybindRegistry) do
                if item.keybindBtn and item.keybindBtn.Visible and isInside(clickX, clickY, item.keybindBtn) then
                    openModeMenuForItem(item)
                    return
                end
            end
        end
    end

    -- 5. Central Keybinds Dispatch Engine
    if isTyping() then
        return
    end

    for _, item in ipairs(keybindRegistry) do
        local k = item.getKey()
        local matches = false
        if k then
            if type(k) == "string" then
                if k == "WheelUp" and input.UserInputType == Enum.UserInputType.MouseWheel and input.Position.Z > 0 then
                    matches = true
                elseif k == "WheelDown" and input.UserInputType == Enum.UserInputType.MouseWheel and input.Position.Z < 0 then
                    matches = true
                end
            elseif input.KeyCode == k or input.UserInputType == k then
                matches = true
            end
        end

        if matches then
            local m = (item.getMode() or "toggle"):lower()
            if m == "toggle" then
                item.toggle()
            elseif m == "hold" then
                item.set(true)
                if type(k) == "string" and (k == "WheelUp" or k == "WheelDown") then
                    task.delay(0.2, function()
                        if (item.getMode() or "toggle"):lower() == "hold" then
                            item.set(false)
                        end
                    end)
                end
            elseif m == "always" then
                item.set(true)
            end
        end
    end
end)

