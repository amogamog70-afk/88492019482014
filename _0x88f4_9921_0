local HttpService = game:GetService("HttpService")
local AutoLoadSettingsFile = (Window.ConfigFolder or "NeverLose_Configs") .. "/.autoload_settings.json"

-- Get saved Auto-Load state (persists across launches)
local function GetSavedAutoLoadState()
    local state = { Enabled = false, Target = "Default" }
    pcall(function()
        if isfile and isfile(AutoLoadSettingsFile) then
            local decoded = HttpService:JSONDecode(readfile(AutoLoadSettingsFile))
            if typeof(decoded) == "table" then
                state.Enabled = (decoded.Enabled == true)
                state.Target = tostring(decoded.Target or "Default")
            end
        end
    end)
    return state
end

-- Save Auto-Load state to disk
local function SaveAutoLoadState(enabled, targetConfig)
    pcall(function()
        local folder = Window.ConfigFolder or "NeverLose_Configs"
        if isfolder and not isfolder(folder) and makefolder then
            makefolder(folder)
        end
        local data = {
            Enabled = (enabled == true),
            Target = tostring(targetConfig or "Default")
        }
        if writefile then
            writefile(AutoLoadSettingsFile, HttpService:JSONEncode(data))
        end
    end)
end

-- Retrieve list of existing user-created configs from filesystem
local function GetSavedUserConfigs()
    local configs = {}
    pcall(function()
        local folder = Window.ConfigFolder or "NeverLose_Configs"
        if isfolder and not isfolder(folder) and makefolder then
            makefolder(folder)
        end
        if listfiles then
            for _, path in ipairs(listfiles(folder)) do
                local name = string.sub(path, #folder + 2)
                if name and name ~= "" and not string.find(name, "^%.") and not table.find(configs, name) then
                    table.insert(configs, name)
                end
            end
        end
    end)
    if #configs == 0 then
        table.insert(configs, "Default")
    end
    return configs
end

-- Load and apply any config by name
local function LoadConfigByName(configName)
    local folder = Window.ConfigFolder or "NeverLose_Configs"
    local path = folder .. "/" .. configName
    if not (isfile and isfile(path)) then
        return false
    end

    local rawData = readfile(path)
    if not rawData or rawData == "" then return false end

    -- 1. Try loading via built-in ConfigLib
    if Window.ConfigLib and Window.ConfigLib.LoadData then
        pcall(function()
            Window.ConfigLib:LoadData(rawData)
            Window.ConfigLib.SelectedConfig = configName
        end)
    else
        -- 2. Direct fallback decoder
        pcall(function()
            local b64Decoded = NeverLose.Base64Decode and NeverLose.Base64Decode(rawData) or rawData
            local main_data = string.split(b64Decoded, '?')
            local seed_str = main_data[1]:gsub('{',''):gsub('}','')
            local seed = tonumber(seed_str)
            local real_seed = seed - 72667
            local ks = {}
            for i, v in ipairs(main_data) do
                if i > 1 then
                    local fake_byte = tonumber(v)
                    table.insert(ks, string.char(fake_byte - real_seed))
                end
            end
            local jsonStr = table.concat(ks)
            local parsed = HttpService:JSONDecode(jsonStr)
            for _, item in ipairs(parsed) do
                if item.Idx and NeverLose.Flags[item.Idx] then
                    task.spawn(function()
                        NeverLose.Flags[item.Idx]:SetValue(item.Value)
                    end)
                end
            end
        end)
    end

    Logging.new("folder", "Auto-Loaded: " .. tostring(configName), 4)
    return true
end

