local function ForceCloseAllPopups()
    -- 1. Закрываем окно профиля и настроек UserSettings
    if Window.UserSettings and Window.UserSettings.Signal then
        pcall(function()
            Window.UserSettings.Signal:SetValue(false)
        end)
    end

    -- 2. Закрываем всплывающее меню конфигов
    if Window.ConfigLib and Window.ConfigLib.SetRender then
        pcall(function()
            Window.ConfigLib.SetRender(false)
        end)
    end

    -- 3. Находим в ScreenGui все летающие дропдауны/колорпикеры и скрываем их
    pcall(function()
        local sg = NeverLose.ScreenGui or game:GetService("CoreGui"):FindFirstChildOfClass("ScreenGui")
        if sg then
            for _, item in ipairs(sg:GetChildren()) do
                -- Дропдауны и всплывашки Neverlose имеют ZIndex >= 100
                if item:IsA("Frame") and item.Name ~= "Neverlose_KeybindsHUD" and item.ZIndex >= 50 then
                    if item:FindFirstChildOfClass("ScrollingFrame") or item:FindFirstChildOfClass("UIListLayout") then
                        item.Visible = false
                        item.BackgroundTransparency = 1
                        for _, desc in ipairs(item:GetDescendants()) do
                            if desc:IsA("TextLabel") or desc:IsA("TextBox") or desc:IsA("TextButton") then
                                desc.TextTransparency = 1
                            elseif desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                                desc.ImageTransparency = 1
                            elseif desc:IsA("UIStroke") then
                                desc.Transparency = 1
                            elseif desc:IsA("GuiObject") then
                                desc.BackgroundTransparency = 1
                            end
                        end
                    end
                end
            end
        end
        NeverLose.IsMosueOverOtherFrame = false
    end)
end

-- Хукаем метод скрытия интерфейса для закрытия всех дропдаунов и настроек
local rawToggleInterface = Window.ToggleInterface
Window.ToggleInterface = function(self, ...)
    local isOpen = Window.Signal and Window.Signal:GetValue()
    if isOpen then
        ForceCloseAllPopups()
    end
    return rawToggleInterface(self, ...)
end

-- Хукаем сигнал видимости
