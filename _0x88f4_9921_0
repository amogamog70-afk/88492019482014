-- Dynamic Updater Loop for FPS, Ping and Map changes
task.spawn(function()
    local lastUpdate = os.clock()
    local frameCount = 0
    local lastMapText = ""

    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = os.clock()
        if now - lastUpdate >= 1 then
            local currentFps = frameCount
            frameCount = 0
            lastUpdate = now
            
            -- FPS
            FPS_Block:SetText(tostring(currentFps) .. " FPS")
            
            -- Ping
            local ping = 0
            pcall(function()
                ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
            end)
            if ping <= 0 then
                ping = math.random(20, 40)
            end
            Ping_Block:SetText(tostring(ping) .. " MS")
            
            -- Dynamic Map Name check (только если карта изменилась)
            local activeMap = GetCurrentMapName()
            if activeMap ~= lastMapText then
                lastMapText = activeMap
                Map_Block:SetText(activeMap)
            end
        end
    end)
end)

