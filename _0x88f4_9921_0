local function FormatMapName(rawName)
    if not rawName or rawName == "" then return "Unknown Map" end
    local lower = string.lower(rawName)
    if MapDisplayNames[lower] then
        return MapDisplayNames[lower]
    end
    for key, formatted in pairs(MapDisplayNames) do
        if string.find(lower, key, 1, true) then
            return formatted
        end
    end
    return rawName
end

local lastCachedMap = nil
local lastMapCheck = 0

local function GetCurrentMapName()
    local now = os.clock()
    -- Кэшируем проверку карты на 1 секунду для экономии CPU
    if lastCachedMap and (now - lastMapCheck < 1) then
        return lastCachedMap
    end
    lastMapCheck = now

    -- 1. Check BloxStrike MapName attribute on workspace.Map
    local wsMap = workspace:FindFirstChild("Map") or workspace:FindFirstChild("CurrentMap")
    if wsMap then
        local attr = wsMap:GetAttribute("MapName") or wsMap:GetAttribute("Map") or wsMap:GetAttribute("DisplayName")
        if attr and tostring(attr) ~= "" then
            lastCachedMap = FormatMapName(tostring(attr))
            return lastCachedMap
        end

        -- Blacklist internal engine folders inside workspace.Map
        local blacklist = {
            ["zones"] = true,
            ["spawns"] = true,
            ["geometry"] = true,
            ["barriers"] = true,
            ["sounds"] = true,
            ["lighting"] = true,
            ["clips"] = true,
            ["props"] = true,
            ["hitboxes"] = true,
            ["colliders"] = true,
            ["models"] = true,
            ["callouts"] = true,
            ["nodes"] = true
        }

        -- Check if any child matches a known map name or is not blacklisted
        for _, child in ipairs(wsMap:GetChildren()) do
            local nameLower = string.lower(child.Name)
            if not blacklist[nameLower] then
                local formatted = FormatMapName(child.Name)
                if formatted ~= child.Name or MapDisplayNames[nameLower] then
                    lastCachedMap = formatted
                    return lastCachedMap
                end
            end
        end

        if wsMap.Name ~= "Map" and wsMap.Name ~= "CurrentMap" then
            lastCachedMap = FormatMapName(wsMap.Name)
            return lastCachedMap
        end
    end

    -- 2. Check Workspace Root Attributes
    local wsAttr = workspace:GetAttribute("MapName") or workspace:GetAttribute("Map") or workspace:GetAttribute("CurrentMap")
    if wsAttr and tostring(wsAttr) ~= "" then
        lastCachedMap = FormatMapName(tostring(wsAttr))
        return lastCachedMap
    end

    -- 3. Check BloxStrike Database / GameStats in ReplicatedStorage
    local success, rsMap = pcall(function()
        local db = ReplicatedStorage:FindFirstChild("Database")
        if db then
            local cs = db:FindFirstChild("Custom")
            if cs then
                local gs = cs:FindFirstChild("GameStats")
                if gs then
                    local mapVal = gs:FindFirstChild("CurrentMap") or gs:FindFirstChild("Map")
                    if mapVal and mapVal.Value ~= "" then
                        return FormatMapName(mapVal.Value)
                    end
                end
            end
        end
        return nil
    end)
    if success and rsMap then
        lastCachedMap = rsMap
        return lastCachedMap
    end

    -- 4. Check ReplicatedStorage Attributes
    local rsAttr = ReplicatedStorage:GetAttribute("MapName") or ReplicatedStorage:GetAttribute("CurrentMap")
    if rsAttr and tostring(rsAttr) ~= "" then
        lastCachedMap = FormatMapName(tostring(rsAttr))
        return lastCachedMap
    end

    -- 5. Fallback Default
    lastCachedMap = "Mirage"
    return lastCachedMap
end

