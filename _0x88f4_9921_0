local function LoadNeverLoseLibrary()
    -- 1. Try loading from local executor workspace
    if isfile and isfile("NEVERLOOSE/GUI/source.luau") then
        local content = readfile("NEVERLOOSE/GUI/source.luau")
        local fn, err = loadstring(content)
        if fn then
            return fn()
        else
            warn("[Neverlose] Failed to load local source.luau:", err)
        end
    end

    -- 2. Try loading from GitHub repository
    local success, result = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/amogamog70-afk/88492019482014/refs/heads/main/109482_994810_04"))()
    end)

    if success and result then
        return result
    end

    error("[Neverlose] Could not load Neverlose UI Library. Make sure internet connection or local files are accessible.")
end

