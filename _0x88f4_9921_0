-- Dynamically keep config list dropdown updated with new user configs (smart diff check)
task.spawn(function()
    local lastConfigCount = -1
    while task.wait(3) do
        pcall(function()
            if AutoLoad_Dropdown and AutoLoad_Dropdown.SetValues then
                local currentConfigs = GetSavedUserConfigs()
                if #currentConfigs ~= lastConfigCount then
                    lastConfigCount = #currentConfigs
                    AutoLoad_Dropdown:SetValues(currentConfigs)
                end
            end
        end)
    end
end)

